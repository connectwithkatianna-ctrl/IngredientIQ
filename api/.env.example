# Server
PORT=8787

# Comma-separated list of valid production API keys (must start with iiq_live_).
# Any key starting with iiq_test_ is accepted automatically as a sandbox key.
API_KEYS=iiq_live_replace_me_with_a_real_key

# Requests allowed per API key per rolling hour.
RATE_LIMIT_PER_HOUR=1000

# Optional: enables the USDA FoodData Central step in the barcode lookup
# cascade when a caller doesn't pass their own fdc_api_key in options.
# FDC_API_KEY=

# Optional: enables a web-search fallback (via Anthropic's API) for barcodes
# not found in Open Food Facts or USDA FDC. Leave unset to skip this step.
# ANTHROPIC_API_KEY=
