{
  "manifest_version": 3,
  "name": "IngredientIQ — Food Safety Warnings",
  "version": "1.0.0",
  "description": "Real-time ingredient safety warnings in MyFitnessPal, MacrosFirst, Cronometer & more. Powered by FDA, FSIS & EWG data.",

  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],

  "host_permissions": [
    "https://www.myfitnesspal.com/*",
    "https://app.macrosfirst.com/*",
    "https://cronometer.com/*",
    "https://www.loseit.com/*",
    "http://localhost:8787/*"
  ],

  "content_scripts": [
    {
      "matches": [
        "https://www.myfitnesspal.com/*",
        "https://app.macrosfirst.com/*",
        "https://cronometer.com/*",
        "https://www.loseit.com/*"
      ],
      "js": ["content.js"],
      "css": ["warning.css"],
      "run_at": "document_idle"
    }
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "IngredientIQ"
  },

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "web_accessible_resources": [
    {
      "resources": ["warning.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
